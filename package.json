{
  "name": "kyara-mythical-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Cloudflare dashboard for Kyara Mythical card medians, updated by GitHub Actions.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
