{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "market",
	"main": "src/worker.mjs",
	"compatibility_date": "2026-10-14",
	"workers_dev": true,
	"durable_objects": { "bindings": [{ "name": "TRADES", "class_name": "TradesCoordinator" }] },
	"migrations": [{ "tag": "trades-v1", "new_sqlite_classes": ["TradesCoordinator"] }],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"kv_namespaces": [
		{
			"binding": "PRICES",
			// Replace this placeholder with the ID from: npx wrangler kv namespace create PRICES
			"id": "6660ff117f254e77aa68d9c02a7f2b50",
			"remote": true
		}
	]
}
